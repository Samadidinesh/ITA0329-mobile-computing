
import math

def fspl_db(d_km, f_mhz):
    return 20 * math.log10(d_km) + 20 * math.log10(f_mhz) + 32.44

def rx_power_dbm(pt_dbm, gt_db, gr_db, d_km, f_mhz):
    return pt_dbm + gt_db + gr_db - fspl_db(d_km, f_mhz)

f, pt, gt, gr, sens = 2400, 20, 2, 2, -90

print("Distance   FSPL     Pr(dBm)   Link")

for d in (0.01, 0.05, 0.1, 0.5, 1, 2, 5, 10):
    pr = rx_power_dbm(pt, gt, gr, d, f)
    print(d, fspl_db(d, f), pr,
          "OK" if pr >= sens else "FAIL")

allowed_loss = pt + gt + gr - sens
d_max = 10 ** ((allowed_loss - 32.44 -
                20 * math.log10(f)) / 20)

print("Maximum range:", round(d_max, 2), "km")
print("Doubling distance adds 6.02 dB loss")

for fm in (900, 1800, 2400, 3500):
    print(fm, "MHz:", fspl_db(1, fm), "dB")
