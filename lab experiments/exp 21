
import numpy as np

rng = np.random.default_rng(3)

U, RB, TTI = 5, 50, 3000

dist = np.array([100, 200, 300, 400, 500.0])

mean_snr_db = 40 - 35 * np.log10(dist / 100)
mean_snr = 10 ** (mean_snr_db / 10)

def rate(snr):
    return np.minimum(np.log2(1 + snr), 6.0) * 180

def simulate(sched):
    thr = np.zeros(U)
    avg = np.ones(U)

    for t in range(TTI):
        fade = rng.exponential(1.0, (U, RB))
        r = rate(mean_snr[:, None] * fade)

        if sched == "RR":
            owner = (np.arange(RB) + t) % U
        elif sched == "MAXCI":
            owner = r.argmax(axis=0)
        else:
            owner = (r / avg[:, None]).argmax(axis=0)

        got = np.zeros(U)

        for b in range(RB):
            got[owner[b]] += r[owner[b], b]

        avg = 0.99 * avg + 0.01 * got
        thr += got

    return thr / TTI / 1000

def jain(x):
    return x.sum()**2 / (len(x) * (x**2).sum())

print("Sched   UE1    UE2    UE3    UE4    UE5   Total  Jain")

for s in ("RR", "MAXCI", "PF"):
    x = simulate(s)

    print(f"{s:6}", end="")

    for v in x:
        print(f"{v:7.2f}", end="")

    print(f"{x.sum():8.2f}{jain(x):7.3f}")
